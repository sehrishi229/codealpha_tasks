<div class="post-card post-detail-card" id="post-<%= post.id %>">
  <div class="post-header">
    <img src="<%= getAvatarUrl({ profile_picture: post.profile_picture, username: post.username, full_name: post.full_name }) %>"
         alt="<%= post.username %> avatar" class="avatar">
    <div>
      <a href="/profile/<%= post.username %>" class="post-author"><%= post.full_name || post.username %></a>
      <span class="post-username">@<%= post.username %></span>
    </div>
    <span class="post-time"><%= formatTime(post.created_at) %></span>
  </div>

  <% if (post.image) { %>
    <div class="post-image">
      <img src="/uploads/<%= post.image %>" alt="Post image" class="post-img">
    </div>
  <% } %>

  <% if (post.document) { %>
    <div class="post-document">
      <a href="/uploads/<%= post.document %>" target="_blank" class="document-link">
        <i class="fas fa-file-pdf"></i>
        <span>View Document</span>
      </a>
    </div>
  <% } %>

  <div class="post-content">
    <p class="post-text"><%= escapeHtml(post.content) %></p>
  </div>

  <div class="post-stats">
    <span><%= post.like_count %> likes</span>
    <span><%= post.comment_count %> comments</span>
  </div>

  <div class="post-interactions">
    <button class="interaction-btn like-btn" data-post-id="<%= post.id %>">
      <i class="fas fa-heart <%= post.user_liked ? 'liked' : '' %>"></i>
      <span class="like-count"><%= post.like_count %></span>
    </button>
    <a href="#comments" class="interaction-btn">
      <i class="far fa-comment"></i>
      <span><%= post.comment_count %></span>
    </a>
  </div>
</div>