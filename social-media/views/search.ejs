<div class="search-container max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-4">Find People</h1>

  <form action="/search" method="GET" class="search-form">
    <div class="form-group">
      <input type="text" name="q" value="<%= query %>" placeholder="Search by username or name..." class="w-full">
    </div>
  </form>

  <% if (users.length === 0) { %>
    <div class="card">
      <div class="card-body text-center py-8">
        <i class="fas fa-search text-4xl text-gray-300 mb-4"></i>
        <p class="text-gray">No users found. Try a different search term.</p>
      </div>
    </div>
  <% } else { %>
    <div class="user-list">
      <% users.forEach(user => { %>
        <div class="user-card">
          <img src="<%= getAvatarUrl({ profile_picture: user.profile_picture, username: user.username, full_name: user.full_name }) %>"
               alt="<%= user.username %> avatar" class="avatar">
          <div class="user-info">
            <a href="/profile/<%= user.username %>" class="user-name"><%= user.full_name || user.username %></a>
            <span class="user-username">@<%= user.username %></span>
            <% if (user.bio) { %>
              <p class="user-bio"><%= escapeHtml(user.bio) %></p>
            <% } %>
          </div>
          <% if (currentUser && currentUser.id !== user.id) { %>
            <button class="btn btn-sm follow-btn" data-user-id="<%= user.id %>"
                    data-action="<%= user.is_following ? 'unfollow' : 'follow' %>">
              <%= user.is_following ? 'Following' : 'Follow' %>
            </button>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>