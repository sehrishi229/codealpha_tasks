<div class="feed-container">
  <div class="feed-sidebar">
    <div class="card">
      <div class="card-body text-center">
        <img src="/uploads/<%= currentUser.avatar || 'default-avatar.svg' %>"
             alt="Your avatar" class="avatar-lg mx-auto">
        <h3 class="mt-2 mb-1"><%= currentUser.full_name %></h3>
        <p class="text-gray">@<%= currentUser.username %></p>
      </div>
    </div>
  </div>

  <div class="feed-main">
    <% if (posts.length === 0) { %>
      <div class="card">
        <div class="card-body text-center py-8">
          <i class="fas fa-feather text-4xl text-gray-300 mb-4"></i>
          <p class="text-gray">No posts yet. Follow users or create a post!</p>
          <a href="/create-post" class="btn btn-primary mt-4">Create Post</a>
        </div>
      </div>
    <% } else { %>
      <%- include('partials/post-card', { posts: posts }) %>
    <% } %>
  </div>
</div>