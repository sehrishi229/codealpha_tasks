<div class="error-container">
  <div class="card">
    <div class="card-body text-center py-12">
      <i class="fas fa-exclamation-triangle text-5xl text-yellow mb-4"></i>
      <h1 class="text-2xl font-bold mb-2"><%= error.message || 'Something went wrong' %></h1>
      <% if (error.status === 404) { %>
        <p class="text-gray mb-4">The page you're looking for doesn't exist.</p>
      <% } else { %>
        <p class="text-gray mb-4">An unexpected error occurred. Please try again later.</p>
      <% } %>
      <a href="/" class="btn btn-primary">Go Home</a>
    </div>
  </div>
</div>